{
	"name": "purple-bread-9739",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"start": "wrangler dev",
		"dev": "wrangler dev",
		"cf-typegen": "wrangler types",
		"test": "vitest run",
		"test:race-conditions": "vitest run tests/race-condition.test.ts --reporter=verbose",
		"test:all": "npm test && npm run test:race-conditions",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit --skipLibCheck",
		"lint": "eslint src tests --ext .ts,.js",
		"lint:fix": "eslint src tests --ext .ts,.js --fix",
		"format": "prettier --write \"src/**/*.{ts,js,json,md}\" \"tests/**/*.{ts,js,json,md}\" \"docs/**/*.md\"",
		"format:check": "prettier --check \"src/**/*.{ts,js,json,md}\" \"tests/**/*.{ts,js,json,md}\" \"docs/**/*.md\"",
		"quality-check": "npm run type-check && npm run lint && npm run format:check && npm run test",
		"quality-fix": "npm run lint:fix && npm run format",
		"quality-audit": "npm run quality:type-audit && npm run quality:linter-audit && npm run quality:validate-fixes",
		"quality:type-audit": "ts-node scripts/type-safety-auditor.ts",
		"quality:linter-audit": "ts-node scripts/linter-audit.ts",
		"quality:validate-fixes": "ts-node scripts/validate-fixes.ts",
		"quality:track-progress": "ts-node scripts/type-improvement-tracker.ts",
		"ci:performance": "ts-node scripts/ci-performance-monitor.ts",
		"quality:report": "ts-node scripts/quality-metrics-reporter.ts",
		"test:performance": "vitest run tests/performance --reporter=verbose",
		"test:integration": "vitest run tests/integration --reporter=verbose",
		"test:message-formatter": "vitest run tests/message-formatter* --reporter=verbose",
		"test:database": "DATABASE_URL=file:./test.db vitest run tests/integration --reporter=verbose",
		"security-check": "npm audit --audit-level=moderate && eslint src --config .eslintrc.security.js",
		"smoke-test": "ts-node scripts/smoke-test.ts",
		"verify-system": "bash scripts/verify-system.sh",
		"health-check": "ts-node -e \"import('./src/utils/health-check').then(m => new m.HealthChecker(process.env as any).checkSystemHealth().then(r => console.log(JSON.stringify(r, null, 2))))\""
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250810.0",
		"@miniflare/core": "^2.14.4",
		"@miniflare/d1": "^2.14.4",
		"@miniflare/kv": "^2.14.4",
		"@miniflare/storage-memory": "^2.14.4",
		"@types/glob": "^8.1.0",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"@vitest/coverage-v8": "^3.2.3",
		"eslint": "^8.45.0",
		"eslint-import-resolver-typescript": "^3.10.1",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^46.10.1",
		"eslint-plugin-security": "^1.7.1",
		"glob": "^11.0.3",
		"husky": "^8.0.3",
		"prettier": "^3.0.0",
		"typescript": "^5.9.2",
		"vitest": "^3.2.3",
		"wrangler": "^4.26.1"
	}
}
