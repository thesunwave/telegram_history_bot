{
	"name": "purple-bread-9739",
	"version": "0.0.0",
	"private": true,
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:production": "wrangler deploy --config wrangler.production.jsonc",
		"deploy:public": "wrangler deploy --config wrangler.public.jsonc && npm run db:migrate:public",
		"db:migrate:public": "wrangler d1 migrations apply DB --remote --config wrangler.public.jsonc",
		"check:production": "wrangler deploy --dry-run --config wrangler.production.jsonc",
		"check:public": "wrangler deploy --dry-run --config wrangler.public.jsonc",
		"dev:public": "wrangler dev --config wrangler.public.jsonc",
		"start": "wrangler dev",
		"dev": "wrangler dev",
		"cf-typegen": "wrangler types",
		"test": "vitest run",
		"dev:remote": "wrangler dev --remote --var ENVIRONMENT:development",
		"dev:polling": "node scripts/local-polling.js",
		"ingest:legal-rag": "node scripts/ingest-legal-rag.mjs",
		"backfill:criminal-punishments": "node scripts/fixes/backfill-criminal-punishments.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250810.0",
		"@miniflare/core": "^2.14.4",
		"@miniflare/d1": "^2.14.4",
		"@miniflare/kv": "^2.14.4",
		"@miniflare/storage-memory": "^2.14.4",
		"better-sqlite3": "^11.10.0",
		"typescript": "^5.0.4",
		"vitest": "^3.2.3",
		"wrangler": "^4.107.1"
	},
	"cloudflare": {
		"bindings": {
			"TOKEN": {
				"description": "Telegram bot token from BotFather. Stored as a Cloudflare Worker Secret."
			}
		}
	},
	"dependencies": {
		"dotenv": "^17.2.3",
		"jose": "^6.2.12"
	}
}
