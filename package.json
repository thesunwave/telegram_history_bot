{
	"name": "telegram-history-bot-template",
	"version": "0.0.0",
	"private": true,
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"deploy": "wrangler deploy",
		"postdeploy": "wrangler d1 migrations apply DB --remote",
		"deploy:production": "wrangler deploy --config wrangler.production.jsonc && wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
		"start": "wrangler dev",
		"dev": "wrangler dev",
		"cf-typegen": "wrangler types",
		"test": "vitest run",
		"test:race-conditions": "vitest run tests/race-condition.test.ts --reporter=verbose",
		"test:all": "npm test && npm run test:race-conditions",
		"dev:remote": "wrangler dev --remote --var ENVIRONMENT:development",
		"dev:polling": "node scripts/local-polling.js",
		"ingest:legal-rag": "node scripts/ingest-legal-rag.mjs",
		"backfill:criminal-punishments": "node scripts/fixes/backfill-criminal-punishments.mjs"
	},
	"cloudflare": {
		"bindings": {
			"TOKEN": {
				"description": "Telegram bot token issued by BotFather. Store it only as a Worker Secret."
			},
			"SECRET": {
				"description": "Random Telegram webhook secret. Generate one with `openssl rand -hex 32`."
			},
			"OPENAI_API_KEY": {
				"description": "Optional. Add this Worker Secret later only if you enable OpenAI summaries."
			}
		}
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260815.1",
		"@miniflare/core": "^2.14.4",
		"@miniflare/d1": "^2.14.4",
		"@miniflare/kv": "^2.14.4",
		"@miniflare/storage-memory": "^2.14.4",
		"typescript": "^5.0.4",
		"vitest": "^3.2.3",
		"wrangler": "^4.123.0"
	},
	"dependencies": {
		"dotenv": "^17.2.3"
	}
}
