{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-stats-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-27",

  // Deploy to Cloudflare can provision these resources for each fork.
  // Manual deploy users should replace placeholder IDs after running ./setup.sh.
  "kv_namespaces": [
    {
      "binding": "HISTORY",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    },
    {
      "binding": "COUNTERS",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram_stats_bot",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTERS_DO",
        "class_name": "CountersDO"
      },
      {
        "name": "MESSAGE_FETCHER_DO",
        "class_name": "MessageFetcherDO"
      },
      {
        "name": "MESSAGE_AGGREGATOR_DO",
        "class_name": "MessageAggregatorDO"
      },
      {
        "name": "DAY_BLOCK_MANAGER_DO",
        "class_name": "DayBlockManager"
      },
      {
        "name": "CRIMINAL_CODE_ANALYZER_DO",
        "class_name": "CriminalCodeAnalyzerDO"
      }
    ]
  },

  "ai": {
    "binding": "AI"
  },

  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "telegram_stats_bot_analytics"
    }
  ],

  // Optional advanced feature. Free tier exists, but the bot does not require
  // legal RAG/criminal analysis in the public default configuration.
  "vectorize": [
    {
      "binding": "LEGAL_RAG_INDEX",
      "index_name": "telegram-stats-legal-rag"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "DEBUG_LOGS": false,

    "SUMMARY_PROVIDER": "cloudflare",
    "PROFANITY_PROVIDER": "cloudflare",
    "CRIMINAL_PROVIDER": "cloudflare",
    "CLOUDFLARE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "SUMMARY_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "SUMMARY_SYSTEM": "You summarize Telegram chat history for the chat owner. Be concise, neutral, privacy-aware, and avoid inventing facts. Mention users only by the display names already present in the messages.",
    "SUMMARY_PROMPT": "Summarize the most important topics, decisions, questions, and notable activity from these Telegram messages. Keep the result structured and easy to scan.",
    "SUMMARY_MAX_TOKENS": 1200,
    "SUMMARY_TEMPERATURE": 0.2,
    "SUMMARY_TOP_P": 0.9,
    "SUMMARY_FREQUENCY_PENALTY": 0.1,

    "PROFANITY_SYSTEM_PROMPT": "Detect explicit profanity in the supplied message. Return strict JSON only.",
    "PROFANITY_USER_PROMPT": "Analyze this message for profanity:",

    "ENABLE_SUMMARY": true,
    "ENABLE_ACTIVITY_TRACKING": true,
    "ENABLE_PROFANITY_ANALYSIS": false,
    "ENABLE_CRIMINAL_ANALYSIS": false,
    "ENABLE_PROFANITY_FROM_CRIMINAL_PREFILTER": false,

    "MESSAGE_BLOCK_CACHE_TTL": 604800,
    "PROFANITY_ANALYSIS_CACHE_TTL": 14400,
    "CRIMINAL_ANALYSIS_CACHE_TTL": 86400,

    "SUMMARY_OPT_ENABLED": true,
    "SUMMARY_OPT_PARALLEL_ENABLED": true,
    "SUMMARY_OPT_MIN_MESSAGES_THRESHOLD": 1000,
    "SUMMARY_OPT_MAX_WORKERS": 3,
    "SUMMARY_OPT_WORKER_BATCH_SIZE": 50,
    "SUMMARY_OPT_WORKER_TIMEOUT": 60000,
    "SUMMARY_OPT_MAX_TOKENS_PER_REQUEST": 32000,
    "SUMMARY_OPT_PREPROCESSING_MAX_TOKENS": 16000,
    "SUMMARY_OPT_FINAL_MAX_TOKENS": 32000,
    "SUMMARY_OPT_TOKEN_ESTIMATION_FACTOR": 4,
    "SUMMARY_OPT_HIERARCHICAL_ENABLED": true,
    "SUMMARY_OPT_CHUNK_SIZE_THRESHOLD": 24000,
    "SUMMARY_OPT_OUTPUT_TOKENS": 1200,
    "SUMMARY_OPT_MAX_PREPROCESSING_CHUNKS": 8,
    "SUMMARY_OPT_ENABLE_DETAILED_METRICS": false,
    "SUMMARY_OPT_LOG_PERFORMANCE_INSIGHTS": false,
    "SUMMARY_OPT_TRACK_TOKEN_USAGE": true,

    "LEGAL_RAG_TOP_K": 8,
    "LEGAL_RAG_MIN_SCORE": 0.55,
    "LEGAL_RAG_LAW_CODE": "uk-rf",
    "LEGAL_RAG_EMBEDDING_MODEL": "@cf/baai/bge-m3"
  },

  "triggers": {
    "crons": [
      "59 23 * * *"
    ]
  },

  "observability": {
    "logs": {
      "enabled": true
    }
  },

  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "CountersDO"
      ]
    },
    {
      "tag": "v2",
      "new_classes": [
        "MessageFetcherDO"
      ]
    },
    {
      "tag": "v3",
      "new_classes": [
        "MessageAggregatorDO"
      ]
    },
    {
      "tag": "v4",
      "new_classes": [
        "DayBlockManager"
      ]
    },
    {
      "tag": "v5",
      "new_classes": [
        "CriminalCodeAnalyzerDO"
      ]
    }
  ]
}
