{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telegram-history-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],

  // Deploy to Cloudflare provisions these resources for each installation.
  "kv_namespaces": [
    { "binding": "HISTORY" },
    { "binding": "COUNTERS" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-history-bot-db",
      "migrations_dir": "migrations",
    },
  ],
  "ai": { "binding": "AI" },

  "durable_objects": {
    "bindings": [
      { "name": "COUNTERS_DO", "class_name": "CountersDO" },
      { "name": "DAY_BLOCK_MANAGER_DO", "class_name": "DayBlockManager" },
      {
        "name": "CRIMINAL_CODE_ANALYZER_DO",
        "class_name": "CriminalCodeAnalyzerDO",
      },
    ],
  },
  "exports": {
    "CountersDO": { "type": "durable-object", "storage": "sqlite" },
    "DayBlockManager": { "type": "durable-object", "storage": "sqlite" },
    "CriminalCodeAnalyzerDO": { "type": "durable-object", "storage": "sqlite" },
  },

  "secrets": {
    "required": ["TOKEN", "SECRET"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SUMMARY_PROVIDER": "cloudflare",
    "CLOUDFLARE_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "OPENAI_MODEL": "gpt-4.1-nano",
    "SUMMARY_SYSTEM": "Ты составляешь краткую и фактическую сводку переписки на русском языке. Упоминай реальные username участников и не выдумывай события.",
    "SUMMARY_PROMPT": "Составь компактную сводку главных тем и событий из сообщений чата. Покажи, кто что сказал или сделал.",
    "SUMMARY_MAX_TOKENS": 1000,
    "SUMMARY_TEMPERATURE": 0.1,
    "SUMMARY_TOP_P": 0.9,
    "DEBUG_LOGS": false,

    // New installations collect statistics without making paid AI calls.
    // The Telegram-only setup wizard explains how to enable OpenAI or Workers AI.
    "ENABLE_SUMMARY": false,
    "ENABLE_ACTIVITY_TRACKING": true,
    "ENABLE_PROFANITY_ANALYSIS": false,
    "ENABLE_PROFANITY_FROM_CRIMINAL_PREFILTER": false,
    "ENABLE_CRIMINAL_ANALYSIS": false,
    "SUMMARY_OPT_ENABLED": false,
    "MESSAGE_BLOCK_CACHE_TTL": 604800,
  },

  "triggers": {
    "crons": ["59 23 * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
}
